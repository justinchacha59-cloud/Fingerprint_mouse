        android:fillColor="#FFFFFF"
        android:strokeColor="#2962FF"
        android:strokeWidth="1.2"
        android:pathData="M3,2 L3,19.5 L7.2,15.8 L9.8,21.5 L12.4,20.3 L9.7,14.6 L15.5,14.6 Z" />
</vector>
